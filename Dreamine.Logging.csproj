<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackageId>Dreamine.Logging</PackageId>
		<Version>1.0.2</Version>
		<Authors>Dreamine Core Team</Authors>
		<Company>Dreamine</Company>
		<Description>WPF logging UI for Dreamine applications: log panel view and view model with bounded display capacity, batched UI dispatcher to coalesce high-frequency log updates, and AutoScroll/EntryAppended hooks.</Description>
		<PackageTags>dreamine;logging;logger;sink;formatter;diagnostics;infrastructure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/CodeMaru-Dreamine/Dreamine.Logging</RepositoryUrl>
		<PackageProjectUrl>https://github.com/CodeMaru-Dreamine/Dreamine.MVVM.FullKit</PackageProjectUrl>
		<Title>Dreamine.Logging</Title>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Copyright>© 2026 Dreamine Core Team. All rights reserved.</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Core\Dreamine.MVVM.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="tests\**\*.cs" />
	  <EmbeddedResource Remove="tests\**\*" />
	  <None Remove="tests\**\*" />
	</ItemGroup>

</Project>
